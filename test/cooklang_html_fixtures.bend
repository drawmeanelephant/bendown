import Base
import ../src/cooklang/parser.bend as Parser
import ../src/cooklang/html.bend as CookHtml

def expect_html_gate(+name: String, +expected: String, +actual: String, ok: Bool) -> IO(Unit):
  match ok:
    case True{}:
      IO.print("PASS " ++ name)
    case False{}:
      IO.die(Unit, 1, "FAIL " ++ name ++ "\nexpected:\n" ++ expected ++ "\nactual:\n" ++ actual)

def expect_html(+name: String, +input: String, +expected: String) -> IO(Unit):
  +actual = CookHtml.render_recipe(Parser.parse_cooklang(input))
  expect_html_gate(name, expected, actual, String.eq(expected, actual))

def main() -> IO(Unit):
  do IO<Unit>:
    expect_html("cooklang-basic", "Add @salt, @ground black pepper{2} and @milk{1/2%cup}.\n\nSimmer in #frying pan{2} for ~{25%minutes}, then let it ~rest.\n", "<article class=\"recipe\">\n<section class=\"ingredients\">\n<h2>Ingredients</h2>\n<ul>\n<li class=\"ingredient\">salt</li>\n<li class=\"ingredient\" data-quantity=\"2\"><span class=\"quantity\">2</span> ground black pepper</li>\n<li class=\"ingredient\" data-quantity=\"1/2\" data-units=\"cup\"><span class=\"quantity\">1/2 cup</span> milk</li>\n</ul>\n</section>\n<ol class=\"steps\">\n<li>Add <span class=\"ingredient\">salt</span>, <span class=\"ingredient\" data-quantity=\"2\">ground black pepper</span> and <span class=\"ingredient\" data-quantity=\"1/2\" data-units=\"cup\">milk</span>.</li>\n<li>Simmer in <span class=\"cookware\" data-quantity=\"2\">frying pan</span> for <time class=\"timer\" data-quantity=\"25\" data-units=\"minutes\" datetime=\"PT25M\">25 minutes</time>, then let it <time class=\"timer\">rest</time>.</li>\n</ol>\n</article>\n")
    expect_html("cooklang-literal", "Message @ example{} and @{3} and ~ 5.\n\n-- a comment line\n\nKeep @red-chilli and @🧂 intact.\n", "<article class=\"recipe\">\n<section class=\"ingredients\">\n<h2>Ingredients</h2>\n<ul>\n<li class=\"ingredient\">red</li>\n<li class=\"ingredient\">🧂</li>\n</ul>\n</section>\n<ol class=\"steps\">\n<li>Message @ example{} and @{3} and ~ 5.</li>\n<li>Keep <span class=\"ingredient\">red</span>-chilli and <span class=\"ingredient\">🧂</span> intact.</li>\n</ol>\n</article>\n")
    expect_html("cooklang-sections", "= Dough\n\nMix @flour{200%g} and @water{100%ml} together until smooth.\n\n== Filling ==\nCombine @cheese{100%g}(grated) and @spinach{50%g}, then season.\n\n> Serve the same day.\n", "<article class=\"recipe\">\n<section class=\"ingredients\">\n<h2>Ingredients</h2>\n<ul>\n<li class=\"ingredient\" data-quantity=\"200\" data-units=\"g\"><span class=\"quantity\">200 g</span> flour</li>\n<li class=\"ingredient\" data-quantity=\"100\" data-units=\"ml\"><span class=\"quantity\">100 ml</span> water</li>\n<li class=\"ingredient\" data-quantity=\"100\" data-units=\"g\"><span class=\"quantity\">100 g</span> cheese <span class=\"preparation\">grated</span></li>\n<li class=\"ingredient\" data-quantity=\"50\" data-units=\"g\"><span class=\"quantity\">50 g</span> spinach</li>\n</ul>\n</section>\n<section>\n<h2>Dough</h2>\n<ol class=\"steps\">\n<li>Mix <span class=\"ingredient\" data-quantity=\"200\" data-units=\"g\">flour</span> and <span class=\"ingredient\" data-quantity=\"100\" data-units=\"ml\">water</span> together until smooth.</li>\n</ol>\n</section>\n<section>\n<h2>Filling</h2>\n<ol class=\"steps\">\n<li>Combine <span class=\"ingredient\" data-quantity=\"100\" data-units=\"g\">cheese <span class=\"preparation\">grated</span></span> and <span class=\"ingredient\" data-quantity=\"50\" data-units=\"g\">spinach</span>, then season.</li>\n</ol>\n<aside class=\"note\">Serve the same day.</aside>\n</section>\n</article>\n")
    expect_html("cooklang-frontmatter", "---\ntitle: Pasta\nservings: 2\n---\n\nBoil @pasta{200%g} in salted water.\n", "<article class=\"recipe\">\n<section class=\"ingredients\">\n<h2>Ingredients</h2>\n<ul>\n<li class=\"ingredient\" data-quantity=\"200\" data-units=\"g\"><span class=\"quantity\">200 g</span> pasta</li>\n</ul>\n</section>\n<ol class=\"steps\">\n<li>Boil <span class=\"ingredient\" data-quantity=\"200\" data-units=\"g\">pasta</span> in salted water.</li>\n</ol>\n</article>\n")
    expect_html("frontmatter-cooklang", "---\nservings: 4\n---\n\nAdd @salt{1%tsp} and @pepper{1/2%tsp}.\n", "<article class=\"recipe\">\n<section class=\"ingredients\">\n<h2>Ingredients</h2>\n<ul>\n<li class=\"ingredient\" data-quantity=\"1\" data-units=\"tsp\"><span class=\"quantity\">1 tsp</span> salt</li>\n<li class=\"ingredient\" data-quantity=\"1/2\" data-units=\"tsp\"><span class=\"quantity\">1/2 tsp</span> pepper</li>\n</ul>\n</section>\n<ol class=\"steps\">\n<li>Add <span class=\"ingredient\" data-quantity=\"1\" data-units=\"tsp\">salt</span> and <span class=\"ingredient\" data-quantity=\"1/2\" data-units=\"tsp\">pepper</span>.</li>\n</ol>\n</article>\n")
    IO.print("cooklang html fixture smoke: all checks passed")
