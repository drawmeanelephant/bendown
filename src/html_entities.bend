# Lookup for HTML5 named entity references that end in a semicolon.  The
# keys are the authoritative names without the leading ampersand and
# trailing semicolon because Markdown scanning has already consumed both.
def html5_named_entity_value(+name: String) -> Maybe<&2, String>:
  match name:
    case SCon{'A', t}:
      html_entity_lookup_encoded(html5_entity_table_A_upper(), name)
    case SCon{'B', t}:
      html_entity_lookup_encoded(html5_entity_table_B_upper(), name)
