# Language-independent full case folding of one Unicode scalar.
# Gaps scan the next populated bucket and stop at its first entry,
# so they correctly report the absence of a mapping.
def unicode_casefold_lookup(+code: U32) -> Maybe<&2, String>:
  ifs(Maybe<&2, String>, U32.is_lt(code, 256),
    u => ucf_lookup_encoded(unicode_casefold_table_0000(), code),
    u =>
    ifs(Maybe<&2, String>, U32.is_lt(code, 512),
      u => ucf_lookup_encoded(unicode_casefold_table_0001(), code),
      u =>
      ifs(Maybe<&2, String>, U32.is_lt(code, 768),
        u => ucf_lookup_encoded(unicode_casefold_table_0002(), code),
        u =>
        ifs(Maybe<&2, String>, U32.is_lt(code, 1024),
          u => ucf_lookup_encoded(unicode_casefold_table_0003(), code),
          u =>
          ifs(Maybe<&2, String>, U32.is_lt(code, 1280),
            u => ucf_lookup_encoded(unicode_casefold_table_0004(), code),
            u =>
            ifs(Maybe<&2, String>, U32.is_lt(code, 1536),
              u => ucf_lookup_encoded(unicode_casefold_table_0005(), code),
              u =>
              ifs(Maybe<&2, String>, U32.is_lt(code, 4352),
                u => ucf_lookup_encoded(unicode_casefold_table_0010(), code),
                u =>
                ifs(Maybe<&2, String>, U32.is_lt(code, 5120),
                  u => ucf_lookup_encoded(unicode_casefold_table_0013(), code),
                  u =>
                  ifs(Maybe<&2, String>, U32.is_lt(code, 7424),
                    u => ucf_lookup_encoded(unicode_casefold_table_001c(), code),
                    u =>
                    ifs(Maybe<&2, String>, U32.is_lt(code, 7936),
                      u => ucf_lookup_encoded(unicode_casefold_table_001e(), code),
                      u =>
                      ifs(Maybe<&2, String>, U32.is_lt(code, 8192),
                        u => ucf_lookup_encoded(unicode_casefold_table_001f(), code),
                        u =>
                        ifs(Maybe<&2, String>, U32.is_lt(code, 8704),
                          u => ucf_lookup_encoded(unicode_casefold_table_0021(), code),
                          u =>
                          ifs(Maybe<&2, String>, U32.is_lt(code, 9472),
                            u => ucf_lookup_encoded(unicode_casefold_table_0024(), code),
                            u =>
                            ifs(Maybe<&2, String>, U32.is_lt(code, 11520),
                              u => ucf_lookup_encoded(unicode_casefold_table_002c(), code),
                              u =>
                              ifs(Maybe<&2, String>, U32.is_lt(code, 42752),
                                u => ucf_lookup_encoded(unicode_casefold_table_00a6(), code),
                                u =>
                                ifs(Maybe<&2, String>, U32.is_lt(code, 43008),
                                  u => ucf_lookup_encoded(unicode_casefold_table_00a7(), code),
                                  u =>
                                  ifs(Maybe<&2, String>, U32.is_lt(code, 44032),
                                    u => ucf_lookup_encoded(unicode_casefold_table_00ab(), code),
                                    u =>
                                    ifs(Maybe<&2, String>, U32.is_lt(code, 64512),
                                      u => ucf_lookup_encoded(unicode_casefold_table_00fb(), code),
                                      u =>
                                      ifs(Maybe<&2, String>, U32.is_lt(code, 65536),
                                        u => ucf_lookup_encoded(unicode_casefold_table_00ff(), code),
                                        u =>
                                        ifs(Maybe<&2, String>, U32.is_lt(code, 66816),
                                          u => ucf_lookup_encoded(unicode_casefold_table_0104(), code),
                                          u =>
                                          ifs(Maybe<&2, String>, U32.is_lt(code, 67072),
                                            u => ucf_lookup_encoded(unicode_casefold_table_0105(), code),
                                            u =>
                                            ifs(Maybe<&2, String>, U32.is_lt(code, 68864),
                                              u => ucf_lookup_encoded(unicode_casefold_table_010c(), code),
                                              u =>
                                              ifs(Maybe<&2, String>, U32.is_lt(code, 69120),
                                                u => ucf_lookup_encoded(unicode_casefold_table_010d(), code),
                                                u =>
                                                ifs(Maybe<&2, String>, U32.is_lt(code, 71936),
                                                  u => ucf_lookup_encoded(unicode_casefold_table_0118(), code),
                                                  u =>
                                                  ifs(Maybe<&2, String>, U32.is_lt(code, 93952),
                                                    u => ucf_lookup_encoded(unicode_casefold_table_016e(), code),
                                                    u =>
                                                    ifs(Maybe<&2, String>, U32.is_lt(code, 125440),
                                                      u => ucf_lookup_encoded(unicode_casefold_table_01e9(), code),
                                                      u =>
                                                      None{}))))))))))))))))))))))))))

def unicode_casefold_char(+c: Char) -> String:
  maybe_case(String, String, unicode_casefold_lookup(Char.to_u32(c)),
    +folded => folded,
    u => SCon{c, SNil{}})
